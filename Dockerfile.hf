# Hugging Face Space (Docker) ke liye: ye file Space mein Dockerfile ke naam se paste karo.
# Ye GitHub repo se apne aap code le leti hai, kuch upload nahi karna.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg nodejs git fonts-noto-core && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 user
USER user
WORKDIR /home/user/app
RUN git clone --depth 1 https://github.com/sahmad-creator/shorts-clipper . && pip install --no-cache-dir -r requirements.txt
ENV HOST=0.0.0.0 PORT=7860 WHISPER_MODEL=base MAX_MINUTES=30
EXPOSE 7860
CMD ["sh", "-c", "gunicorn -w 1 --threads 8 -t 900 -b 0.0.0.0:${PORT:-7860} app:app"]
